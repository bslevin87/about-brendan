# Environment
ENVIRONMENT=development  # development, staging, production

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/crypto_arbitrage

# Redis
REDIS_URL=redis://localhost:6379/0

# Exchange API Keys - Kraken
KRAKEN_API_KEY=your_api_key_here
KRAKEN_API_SECRET=your_api_secret_here

# Exchange API Keys - Binance.US
BINANCE_US_API_KEY=your_api_key_here
BINANCE_US_API_SECRET=your_api_secret_here

# Exchange API Keys - Crypto.com
CRYPTO_COM_API_KEY=your_api_key_here
CRYPTO_COM_API_SECRET=your_api_secret_here

# Exchange API Keys - Bitstamp
BITSTAMP_API_KEY=your_api_key_here
BITSTAMP_API_SECRET=your_api_secret_here

# Exchange API Keys - Gemini
GEMINI_API_KEY=your_api_key_here
GEMINI_API_SECRET=your_api_secret_here

# Exchange API Keys - Coinbase Advanced
COINBASE_ADVANCED_API_KEY=your_api_key_here
COINBASE_ADVANCED_API_SECRET=your_api_secret_here

# Exchange API Keys - OKX.US
OKX_US_API_KEY=your_api_key_here
OKX_US_API_SECRET=your_api_secret_here
OKX_US_PASSPHRASE=your_passphrase_here

# Alerting (for future use)
ALERT_EMAIL=alerts@example.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_ROTATION_DAYS=7

# Security
SECRET_KEY=generate_a_secure_random_key_here
ENCRYPTION_KEY=generate_a_secure_encryption_key_here

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Feature Flags
ENABLE_LIVE_TRADING=false
ENABLE_NOTIFICATIONS=true
ENABLE_METRICS=true
